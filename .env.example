# Where the API lives. .env.development (mock, :5000) and .env.production (live API) already set this;
# copy this file to .env.development.local to point the dev server somewhere else.
VITE_API_BASE_URL=http://localhost:5000/api
# Public address of this app (link previews, canonical URL).
VITE_SITE_URL=http://localhost:5173
